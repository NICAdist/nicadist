+//---- START of QA customization for MPDRoot ----//
+#include <TFile.h>
+#include <TDirectory.h>
+
+int FairTask::fTasksWithHistograms = 0;
+
+void FairTask::WriteHistograms()
+{
+   if (fTaskHistograms->IsEmpty()) return;
+
+   Option_t *fileAccess = (fTasksWithHistograms) ? "UPDATE" : "RECREATE" ;
+   TFile *outputFile = new TFile(kHistogramsFilename, fileAccess);
+   fTasksWithHistograms++;
+   TString taskDirname = TString(std::to_string(fTasksWithHistograms)) + TString("_") + this->GetName();
+   TDirectory *taskDir = outputFile->mkdir(taskDirname);
+   taskDir->cd();
+   
+   TObject *obj;
+   TIter next(fTaskHistograms);
+   while (obj=next()) obj->Write();
+
+   outputFile->Close();
+}
+//---- END of QA customization for MPDRoot ----//
+
